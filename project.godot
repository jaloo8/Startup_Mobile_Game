; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Venture"
run/main_scene="res://src/ui/main_menu/main_menu.tscn"
config/features=PackedStringArray("4.6", "Forward Plus")
config/icon="res://assets/app_icon.png"

[autoload]

GameState="*res://src/autoload/game_state.gd"
SceneLoader="*res://src/autoload/scene_loader.gd"
UITouchHelper="*res://src/autoload/ui_touch_helper_bridge.gd"
WorldEventEngine="*res://src/autoload/world_event_engine_bridge.gd"
Glossary="*res://src/autoload/glossary.gd"
Analytics="*res://src/autoload/analytics.gd"
AdManager="*res://src/autoload/ad_manager.gd"
TutorialManager="*res://src/autoload/tutorial_manager.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/size/mode=2
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[rendering]

textures/canvas_textures/default_texture_filter=0
